{
  "name": "color-picker",
  "productName": "ChipDeck",
  "version": "0.1.2",
  "description": "A fast, unobtrusive color picker for macOS and Windows.",
  "author": {
    "name": "Mario Kernich",
    "email": "mario@kernich.de"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "native": "node scripts/build-native.mjs",
    "postinstall": "node scripts/build-native.mjs --optional",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:mac-release": "npm run build && electron-builder --mac dmg zip --universal -c.mac.notarize=true -c.dmg.sign=true",
    "dist:mas": "npm run build && electron-builder --mac mas --universal",
    "dist:mas-dev": "npm run build && electron-builder --mac mas-dev",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:appx": "npm run build && electron-builder --win appx"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
